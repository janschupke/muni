{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Prague",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Minor and patch updates together, one pull request a week.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch"
    },
    {
      "description": "TypeScript 7 has no JS API: typescript-eslint and Next's type check need 6.x.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "The prisma CLI and client move together, and the CLI's latest tag can be a release candidate.",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg"],
      "groupName": "prisma",
      "ignoreUnstable": true
    }
  ]
}
