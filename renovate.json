{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Prague",
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "description": "Minor and patch updates together, one pull request a week.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch"
    },
    {
      "description": "TypeScript 7 has no JS API: typescript-eslint and Next's type check need 6.x.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "The types follow the Node the app runs on (24, .nvmrc and engines), not the newest.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "description": "The prisma CLI and client move together, and the CLI's latest tag can be a release candidate.",
      "matchPackageNames": ["prisma", "@prisma/client", "@prisma/adapter-pg"],
      "groupName": "prisma",
      "ignoreUnstable": true
    },
    {
      "description": "turbo-ignore (apps/web/vercel.json) moves with turbo.",
      "matchPackageNames": ["turbo", "turbo-ignore"],
      "groupName": "turbo"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The turbo-ignore version Vercel runs, pinned in apps/web/vercel.json.",
      "managerFilePatterns": ["/^apps/web/vercel\\.json$/"],
      "matchStrings": ["turbo-ignore@(?<currentValue>[0-9][^ \"]*)"],
      "depNameTemplate": "turbo-ignore",
      "datasourceTemplate": "npm"
    }
  ]
}
