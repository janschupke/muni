{
  "extends": "../../tsconfig.react.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "../../env.d.ts",
    "next-env.d.ts",
    "src",
    "e2e",
    "*.ts",
    "*.mjs",
    "*.js",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
