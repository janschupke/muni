generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "esm"
  /// Unique indexes skip archived rows (`WHERE archived_at IS NULL`), so an archived record never
  /// blocks a new one with the same name, code or ID.
  previewFeatures = ["partialIndexes", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  /// Case-insensitive names: "aula a" is the same room as "Aula A".
  extensions = [citext]
}

/// Whether someone has left is not a status: it is `leftOn` reached (`leftOn <= today`).
enum EmploymentStatus {
  ACTIVE
  PARENTAL_LEAVE
}

enum RoomKind {
  CLASSROOM
  LAB
  ONLINE
  EXTERNAL
  OUTDOOR
}

/// What a room offers, and what a course needs from one.
enum Capability {
  PROJECTOR
  COMPUTERS
  LAB_EQUIPMENT
  VEHICLE
  PRACTICAL_AREA
  VIDEO_CONFERENCE
  WHEELCHAIR_ACCESS
}

enum SessionStatus {
  PLANNED
  CANCELLED
}

model Department {
  id           String                        @id @default(cuid())
  name         String                        @db.Citext
  employees    Employee[]
  requirements CourseDepartmentRequirement[]
  /// The positions people in the department may hold.
  positions    DepartmentPosition[]
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt   DateTime?                     @map("archived_at")
  archivedById String?                       @map("archived_by_id")
  archivedBy   User?                         @relation("DepartmentArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([name], map: "departments_name_key", where: { archivedAt: null })
  @@map("departments")
}

model Position {
  id           String                      @id @default(cuid())
  name         String                      @db.Citext
  employees    Employee[]
  requirements CoursePositionRequirement[]
  /// The departments the position exists in (a title like "Vedoucí" is shared by many).
  departments  DepartmentPosition[]
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt   DateTime?                   @map("archived_at")
  archivedById String?                     @map("archived_by_id")
  archivedBy   User?                       @relation("PositionArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([name], map: "positions_name_key", where: { archivedAt: null })
  @@map("positions")
}

/// A position held in a department. A person's department and position must be such a pair.
model DepartmentPosition {
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId   String     @map("position_id")
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  employees    Employee[]

  @@id([departmentId, positionId])
  @@index([positionId])
  @@map("department_positions")
}

model Employee {
  id                 String              @id @default(cuid())
  /// Source-system ID (E0001). Imports upsert on it.
  externalId         String              @map("external_id")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  email              String?
  /// Rodné číslo. Sensitive: only ever leaves the server through the sanitisation policy.
  nationalId         String?             @map("national_id")
  departmentId       String?             @map("department_id")
  department         Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId         String?             @map("position_id")
  position           Position?           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  /// The pair must exist: a person holds only a position their department has.
  departmentPosition DepartmentPosition? @relation(fields: [departmentId, positionId], references: [departmentId, positionId], onDelete: Restrict)
  /// Leads their department. One head per department, and only a member (CHECK in the SQL).
  leadsDepartment    Boolean             @default(false) @map("leads_department")
  managerId          String?             @map("manager_id")
  manager            Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports            Employee[]          @relation("EmployeeManager")
  hiredOn            DateTime            @map("hired_on") @db.Date
  leftOn             DateTime?           @map("left_on") @db.Date
  status             EmploymentStatus
  note               String?
  completions        CourseCompletion[]
  assignments        SessionAssignment[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt         DateTime?           @map("archived_at")
  archivedById       String?             @map("archived_by_id")
  archivedBy         User?               @relation("EmployeeArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  /// A random tag that stands for the person once archived (never derived from the id).
  archiveTag         String?             @map("archive_tag")

  @@unique([externalId], map: "employees_external_id_key", where: { archivedAt: null })
  @@unique([email], map: "employees_email_key", where: { archivedAt: null })
  @@unique([departmentId], map: "employees_department_head_key", where: { leadsDepartment: true, archivedAt: null })
  @@index([departmentId])
  @@index([positionId])
  @@index([lastName, firstName])
  @@index([managerId])
  @@map("employees")
}

model Course {
  id                     String                        @id @default(cuid())
  code                   String
  name                   String
  /// null = the course never expires.
  validityMonths         Int?                          @map("validity_months")
  /// Everyone must hold it. Otherwise the department and position rows say who must;
  /// no rows at all = an optional course.
  requiredForAll         Boolean                       @default(false) @map("required_for_all")
  departmentRequirements CourseDepartmentRequirement[]
  positionRequirements   CoursePositionRequirement[]
  /// What one session needs (the planner's input), as the sessions import derives it from the
  /// course's sessions. null = not known yet. The effective need is the override, else this.
  sessionMinutes         Int?                          @map("session_minutes")
  groupSize              Int?                          @map("group_size")
  onlineAllowed          Boolean                       @default(false) @map("online_allowed")
  capabilities           CourseCapability[]
  /// Set in the app; imports never touch them. null = take the derived value above.
  sessionMinutesOverride Int?                          @map("session_minutes_override")
  groupSizeOverride      Int?                          @map("group_size_override")
  onlineAllowedOverride  Boolean?                      @map("online_allowed_override")
  sessions               CourseSession[]
  completions            CourseCompletion[]
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt             DateTime?                     @map("archived_at")
  archivedById           String?                       @map("archived_by_id")
  archivedBy             User?                         @relation("CourseArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([code], map: "courses_code_key", where: { archivedAt: null })
  @@map("courses")
}

/// Everyone in the department must hold the course.
model CourseDepartmentRequirement {
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([courseId, departmentId])
  @@index([departmentId])
  @@map("course_department_requirements")
}

/// Everyone in the position must hold the course.
model CoursePositionRequirement {
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id], onDelete: Restrict)

  @@id([courseId, positionId])
  @@index([positionId])
  @@map("course_position_requirements")
}

/// A capability every room holding the course must have.
model CourseCapability {
  courseId   String     @map("course_id")
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Restrict)
  capability Capability

  @@id([courseId, capability])
  @@map("course_capabilities")
}

model Room {
  id           String           @id @default(cuid())
  name         String           @db.Citext
  kind         RoomKind
  /// Seats. null = no fixed limit, which an online room has and only it (CHECK in the SQL).
  capacity     Int?
  note         String?
  capabilities RoomCapability[]
  sessions     CourseSession[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt   DateTime?        @map("archived_at")
  archivedById String?          @map("archived_by_id")
  archivedBy   User?            @relation("RoomArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([name], map: "rooms_name_key", where: { archivedAt: null })
  @@map("rooms")
}

model RoomCapability {
  roomId     String     @map("room_id")
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Restrict)
  capability Capability

  @@id([roomId, capability])
  @@map("room_capabilities")
}

/// Who delivers training. Imports and the completion form create one by name; its details
/// are filled in the app.
model Provider {
  id           String             @id @default(cuid())
  name         String             @db.Citext
  /// IČO: 8 digits (CHECK in the migration SQL); the schema checks its checksum.
  companyId    String?            @map("company_id")
  email        String?
  phone        String?
  website      String?
  note         String?
  completions  CourseCompletion[]
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt   DateTime?          @map("archived_at")
  archivedById String?            @map("archived_by_id")
  archivedBy   User?              @relation("ProviderArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([name], map: "providers_name_key", where: { archivedAt: null })
  @@unique([companyId], map: "providers_company_id_key", where: { archivedAt: null })
  @@map("providers")
}

model CourseSession {
  id              String              @id @default(cuid())
  /// Source-system ID (T001).
  externalId      String              @map("external_id")
  courseId        String              @map("course_id")
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  startsAt        DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime            @map("ends_at") @db.Timestamptz(3)
  roomId          String              @map("room_id")
  room            Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// CHECK (capacity >= 0) in the migration SQL; Prisma cannot model CHECK constraints.
  capacity        Int
  /// Seats booked without a name (from the source export). The booked total is derived:
  /// unnamedBookings + assignments. CHECK (unnamed_bookings >= 0) in the migration SQL.
  unnamedBookings Int                 @default(0) @map("unnamed_bookings")
  pricePerPerson  Decimal?            @map("price_per_person") @db.Decimal(10, 2)
  status          SessionStatus       @default(PLANNED)
  assignments     SessionAssignment[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt      DateTime?           @map("archived_at")
  archivedById    String?             @map("archived_by_id")
  archivedBy      User?               @relation("SessionArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([externalId], map: "course_sessions_external_id_key", where: { archivedAt: null })
  @@index([startsAt])
  @@index([courseId, startsAt])
  @@index([roomId, startsAt])
  /// "Upcoming" everywhere: planned and not yet ended.
  @@index([status, endsAt])
  @@map("course_sessions")
}

model CourseCompletion {
  id           String    @id @default(cuid())
  /// Source-system ID (Z000001). Records created in the app get an `A`-prefixed ID.
  externalId   String    @map("external_id")
  employeeId   String    @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  courseId     String    @map("course_id")
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  completedOn  DateTime  @map("completed_on") @db.Date
  /// null = never expires.
  validUntil   DateTime? @map("valid_until") @db.Date
  providerId   String?   @map("provider_id")
  provider     Provider? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  price        Decimal?  @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  /// Archived records are hidden from every list and count; nothing is ever deleted.
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")
  archivedBy   User?     @relation("CompletionArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)

  @@unique([externalId], map: "course_completions_external_id_key", where: { archivedAt: null })
  @@index([employeeId, courseId, completedOn])
  @@index([courseId])
  @@index([validUntil])
  @@map("course_completions")
}

enum AssignmentSource {
  /// Applied from the advisor's plan.
  ADVISOR
  MANUAL
}

/// A named booking: this person attends this session. Counts toward the session's seats.
model SessionAssignment {
  id          String           @id @default(cuid())
  sessionId   String           @map("session_id")
  session     CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  employeeId  String           @map("employee_id")
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  source      AssignmentSource @default(MANUAL)
  createdById String           @map("created_by_id")
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, employeeId])
  @@index([employeeId])
  @@index([createdById])
  @@map("session_assignments")
}

/// Mirrors Clerk `publicMetadata.role` (lowercase there). Clerk is the source of truth.
enum UserRole {
  /// Every new sign-up: reads everything, personal data redacted.
  VIEWER
  /// Reads whole records.
  FULL
  /// Also edits, books seats and imports.
  ADMIN
}

/// A signed-in person, mirrored from Clerk at each sign-in and at most every few minutes after.
model User {
  id            String              @id @default(cuid())
  clerkId       String              @map("clerk_id")
  email         String?
  name          String?
  role          UserRole            @default(VIEWER)
  /// The Clerk session last synced: a different one means a new sign-in.
  lastSessionId String?             @map("last_session_id")
  lastSignInAt  DateTime?           @map("last_sign_in_at")
  /// When the row was last read from Clerk.
  syncedAt      DateTime            @map("synced_at")
  /// When an admin last changed the role here: a sync that read Clerk before Clerk had it
  /// never writes the older role back.
  roleChangedAt DateTime?           @map("role_changed_at")
  /// A random tag that stands for the user once archived (never derived from the id).
  archiveTag    String?             @map("archive_tag")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  assignments   SessionAssignment[]
  /// An archived user cannot sign in. Users are never deleted.
  archivedAt    DateTime?           @map("archived_at")
  archivedById  String?             @map("archived_by_id")
  archivedBy    User?               @relation("UserArchivedBy", fields: [archivedById], references: [id], onDelete: Restrict)
  archivedUsers User[]              @relation("UserArchivedBy")

  archivedDepartments Department[]       @relation("DepartmentArchivedBy")
  archivedPositions   Position[]         @relation("PositionArchivedBy")
  archivedEmployees   Employee[]         @relation("EmployeeArchivedBy")
  archivedCourses     Course[]           @relation("CourseArchivedBy")
  archivedRooms       Room[]             @relation("RoomArchivedBy")
  archivedProviders   Provider[]         @relation("ProviderArchivedBy")
  archivedSessions    CourseSession[]    @relation("SessionArchivedBy")
  archivedCompletions CourseCompletion[] @relation("CompletionArchivedBy")

  @@unique([clerkId], map: "users_clerk_id_key", where: { archivedAt: null })
  /// Every request finds the signed-in user by Clerk ID, archived or not.
  @@index([clerkId])
  @@map("users")
}

/// Requests per key (a user and what they do) in fixed one-minute windows: what the rate
/// limit counts. A key's older windows go when it opens a new one.
model RateLimit {
  key         String
  windowStart DateTime @map("window_start")
  count       Int

  @@id([key, windowStart])
  @@map("rate_limits")
}
