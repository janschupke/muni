generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum EmploymentStatus {
  ACTIVE
  PARENTAL_LEAVE
  TERMINATED
}

enum RoomKind {
  CLASSROOM
  LAB
  ONLINE
  EXTERNAL
  OUTDOOR
}

/// What a room offers, and what a course needs from one.
enum Capability {
  PROJECTOR
  COMPUTERS
  LAB_EQUIPMENT
  VEHICLE
  PRACTICAL_AREA
  VIDEO_CONFERENCE
  WHEELCHAIR_ACCESS
}

enum SessionStatus {
  PLANNED
  CANCELLED
}

model Department {
  id           String                        @id @default(cuid())
  name         String                        @unique
  employees    Employee[]
  requirements CourseDepartmentRequirement[]

  @@map("departments")
}

model Position {
  id           String                      @id @default(cuid())
  name         String                      @unique
  employees    Employee[]
  requirements CoursePositionRequirement[]

  @@map("positions")
}

model Employee {
  id           String              @id @default(cuid())
  /// Source-system ID (E0001). Imports upsert on it.
  externalId   String              @unique @map("external_id")
  firstName    String              @map("first_name")
  lastName     String              @map("last_name")
  email        String?             @unique
  /// Rodné číslo. Sensitive: only ever leaves the server through the sanitisation policy.
  nationalId   String?             @map("national_id")
  departmentId String?             @map("department_id")
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId   String?             @map("position_id")
  position     Position?           @relation(fields: [positionId], references: [id], onDelete: SetNull)
  managerId    String?             @map("manager_id")
  manager      Employee?           @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports      Employee[]          @relation("EmployeeManager")
  hiredOn      DateTime            @map("hired_on") @db.Date
  leftOn       DateTime?           @map("left_on") @db.Date
  status       EmploymentStatus
  note         String?
  completions  CourseCompletion[]
  assignments  SessionAssignment[]
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([positionId])
  @@index([lastName, firstName])
  @@map("employees")
}

model Course {
  id                     String                        @id @default(cuid())
  code                   String                        @unique
  name                   String
  /// null = the course never expires.
  validityMonths         Int?                          @map("validity_months")
  /// Everyone must hold it. Otherwise the department and position rows say who must;
  /// no rows at all = an optional course.
  requiredForAll         Boolean                       @default(false) @map("required_for_all")
  departmentRequirements CourseDepartmentRequirement[]
  positionRequirements   CoursePositionRequirement[]
  /// What one session needs (the planner's input). null = not set yet.
  sessionMinutes         Int?                          @map("session_minutes")
  groupSize              Int?                          @map("group_size")
  onlineAllowed          Boolean                       @default(false) @map("online_allowed")
  capabilities           CourseCapability[]
  sessions               CourseSession[]
  completions            CourseCompletion[]
  createdAt              DateTime                      @default(now()) @map("created_at")
  updatedAt              DateTime                      @updatedAt @map("updated_at")

  @@map("courses")
}

/// Everyone in the department must hold the course.
model CourseDepartmentRequirement {
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([courseId, departmentId])
  @@index([departmentId])
  @@map("course_department_requirements")
}

/// Everyone in the position must hold the course.
model CoursePositionRequirement {
  courseId   String   @map("course_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  positionId String   @map("position_id")
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@id([courseId, positionId])
  @@index([positionId])
  @@map("course_position_requirements")
}

/// A capability every room holding the course must have.
model CourseCapability {
  courseId   String     @map("course_id")
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  capability Capability

  @@id([courseId, capability])
  @@map("course_capabilities")
}

model Room {
  id           String           @id @default(cuid())
  name         String           @unique
  kind         RoomKind
  /// Seats. null = no fixed limit (e.g. an online room). CHECK (capacity >= 0) in the SQL.
  capacity     Int?
  note         String?
  capabilities RoomCapability[]
  sessions     CourseSession[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@map("rooms")
}

model RoomCapability {
  roomId     String     @map("room_id")
  room       Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  capability Capability

  @@id([roomId, capability])
  @@map("room_capabilities")
}

model Provider {
  id          String             @id @default(cuid())
  name        String             @unique
  completions CourseCompletion[]

  @@map("providers")
}

model CourseSession {
  id              String              @id @default(cuid())
  /// Source-system ID (T001).
  externalId      String              @unique @map("external_id")
  courseId        String              @map("course_id")
  course          Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startsAt        DateTime            @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime            @map("ends_at") @db.Timestamptz(3)
  /// Restrict: a room with sessions cannot be deleted.
  roomId          String              @map("room_id")
  room            Room                @relation(fields: [roomId], references: [id], onDelete: Restrict)
  /// CHECK (capacity >= 0) in the migration SQL; Prisma cannot model CHECK constraints.
  capacity        Int
  /// Seats booked without a name (from the source export). The booked total is derived:
  /// unnamedBookings + assignments. CHECK (unnamed_bookings >= 0) in the migration SQL.
  unnamedBookings Int                 @default(0) @map("unnamed_bookings")
  pricePerPerson  Decimal?            @map("price_per_person") @db.Decimal(10, 2)
  status          SessionStatus       @default(PLANNED)
  assignments     SessionAssignment[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([courseId, startsAt])
  @@index([roomId, startsAt])
  @@map("course_sessions")
}

model CourseCompletion {
  id          String    @id @default(cuid())
  /// Source-system ID (Z000001). Records created in the app get an `A`-prefixed ID.
  externalId  String    @unique @map("external_id")
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId    String    @map("course_id")
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedOn DateTime  @map("completed_on") @db.Date
  /// null = never expires.
  validUntil  DateTime? @map("valid_until") @db.Date
  providerId  String?   @map("provider_id")
  provider    Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  price       Decimal?  @db.Decimal(10, 2)
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([employeeId, courseId, completedOn])
  @@index([courseId])
  @@index([validUntil])
  @@map("course_completions")
}

enum AssignmentSource {
  /// Applied from the advisor's plan.
  ADVISOR
  MANUAL
}

/// A named booking: this person attends this session. Counts toward the session's seats.
model SessionAssignment {
  id         String           @id @default(cuid())
  sessionId  String           @map("session_id")
  session    CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// Restrict: removing a person must not silently erase their booking history.
  employeeId String           @map("employee_id")
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  source     AssignmentSource @default(MANUAL)
  /// Clerk user id. Clerk owns users, so there is no user table to reference.
  createdBy  String           @map("created_by")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([sessionId, employeeId])
  @@index([employeeId])
  @@map("session_assignments")
}
