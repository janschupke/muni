{
  "name": "@muni/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": "./src/client.ts",
    "./repositories": "./src/repositories/index.ts",
    "./writer": "./src/writer.ts",
    "./reference": "./src/reference.ts"
  },
  "scripts": {
    "generate": "prisma generate --no-hints",
    "check:schema": "prisma validate && prisma format --check",
    "check:drift": "dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "seed": "dotenv -e ../../.env -- tsx scripts/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:integration": "dotenv -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage --config vitest.coverage.config.ts"
  },
  "dependencies": {
    "@muni/domain": "workspace:*",
    "@muni/importer": "workspace:*",
    "@muni/utils": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dotenv-cli": "catalog:",
    "prisma": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
