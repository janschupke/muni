{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    "tsconfig.react.json",
    "env.d.ts",
    "eslint.preset.js",
    "vitest.preset.ts",
    ".prettierrc.json",
    ".nvmrc"
  ],
  "globalPassThroughEnv": ["NODE_OPTIONS"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "@muni/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.env"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "CLERK_SECRET_KEY", "CLERK_DISABLE_AUTO_PROXY"],
      "passThroughEnv": ["DATABASE_URL", "DIRECT_URL", "DATABASE_CA", "MUNI_*", "VERCEL_*"]
    },
    "typecheck": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/data/**"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/data/**"],
      "outputs": ["coverage/**"]
    },
    "@muni/ui#test": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"],
      "outputs": []
    },
    "@muni/ui#test:coverage": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"],
      "outputs": ["coverage/**"]
    },
    "@muni/db#test:coverage": {
      "dependsOn": ["transit", "@muni/db#generate"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["@muni/db#generate"],
      "cache": false,
      "persistent": true
    }
  }
}
