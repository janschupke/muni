# Runtime connection. Prod: Supabase Supavisor transaction pooler (port 6543).
DATABASE_URL=postgresql://muni:muni@localhost:5438/muni
# Migrations only. Prod: Supabase session pooler or direct connection (port 5432). Never the 6543 pooler.
DIRECT_URL=postgresql://muni:muni@localhost:5438/muni
# A database on another host (Supabase) is reached only over TLS checked against its CA: its SSL
# certificate (PEM) here. Unset for the local database.
DATABASE_CA=

# Clerk (required). Development keys from dashboard.clerk.com. Roles live in each user's public metadata: {"role":"viewer"|"full"|"admin"}.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production on Vercel: 1. Otherwise Clerk guesses from Vercel's environment that the browser loads
# it through /__clerk on the app's own host, which nothing serves (docs/deploy.md). Unset locally.
CLERK_DISABLE_AUTO_PROXY=

# Optional JSON override of the field sanitisation policy (merged over packages/domain/src/sanitize/sanitize.config.ts).
# Keys per field are roles. Example: {"employee.email":{"VIEWER":{"mode":"omit"}}}
MUNI_SANITIZE_POLICY=
# Days before expiry at which a completion counts as "expiring". Default 30.
MUNI_EXPIRING_DAYS=
# Requests one user may make per minute: reads (pages, refetches) and writes (saves, bookings, import chunks). Defaults 300 and 60.
MUNI_RATE_LIMIT_READS=
MUNI_RATE_LIMIT_WRITES=
