{
  "name": "muni",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck && pnpm typecheck:root",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint": "turbo run lint && pnpm lint:root",
    "lint:root": "eslint . --max-warnings 0",
    "test": "turbo run test && pnpm test:root",
    "test:root": "vitest run",
    "coverage": "turbo run test:coverage",
    "test:integration": "pnpm --filter @muni/db test:integration",
    "test:e2e": "pnpm --filter @muni/web test:e2e",
    "test:lighthouse": "pnpm --filter @muni/web test:lighthouse",
    "test:visual": "pnpm --filter @muni/web test:visual",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-config-hints && knip --production --no-config-hints",
    "check:schema": "pnpm --filter @muni/db check:schema",
    "check:drift": "pnpm --filter @muni/db check:drift",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm check:schema && pnpm check:drift && pnpm coverage && pnpm test:root && pnpm build",
    "check:changed": "node scripts/check-changed.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @muni/db generate",
    "db:migrate": "pnpm --filter @muni/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @muni/db migrate:deploy",
    "db:reset": "pnpm --filter @muni/db migrate:reset",
    "db:seed": "pnpm --filter @muni/db seed",
    "db:studio": "pnpm --filter @muni/db studio"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "catalog:",
    "@eslint/js": "catalog:",
    "@next/eslint-plugin-next": "catalog:",
    "@types/node": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y-x": "catalog:",
    "eslint-plugin-playwright": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-simple-import-sort": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
